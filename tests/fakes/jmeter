#!/usr/bin/env python3
"""Stand-in for the jmeter launcher in the entrypoint tests.

Non-GUI run (-n): copies $FAKE_JMETER_JTL to the -l path and writes a log to -j.
Report (-g): creates a minimal dashboard in the -o directory.
$FAKE_JMETER_SLEEP keeps a run busy (to test signal handling). Exit status comes from
$FAKE_JMETER_EXIT. Calls are logged to $FAKE_JMETER_LOG.
"""

import json
import os
import shutil
import sys
import time
from pathlib import Path

args = sys.argv[1:]
with Path(os.environ["FAKE_JMETER_LOG"]).open("a") as log:
    log.write(json.dumps(args) + "\n")


def option(flag: str) -> str:
    return args[args.index(flag) + 1]


if "-g" in args:
    report = Path(option("-o"))
    if report.exists():
        print("output folder must not exist", file=sys.stderr)
        sys.exit(1)
    (report / "content").mkdir(parents=True)
    (report / "index.html").write_text("<html>dashboard</html>\n")
    (report / "statistics.json").write_text("{}\n")
elif "-n" in args:
    Path(option("-j")).write_text("fake jmeter log\n")
    if os.environ.get("FAKE_JMETER_JTL"):
        shutil.copyfile(os.environ["FAKE_JMETER_JTL"], option("-l"))
    time.sleep(float(os.environ.get("FAKE_JMETER_SLEEP", "0")))

sys.exit(int(os.environ.get("FAKE_JMETER_EXIT", "0")))
