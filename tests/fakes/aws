#!/usr/bin/env python3
"""Stand-in for the AWS CLI in the shell-script tests.

* ``s3 cp`` maps s3://<bucket>/<key> to $FAKE_S3_ROOT/<bucket>/<key> and supports
  --recursive with --exclude/--include filters (later filters win, as in the real CLI).
* ``stepfunctions start-execution`` / ``describe-execution`` print canned values.

Every call is appended to $FAKE_AWS_LOG as one JSON array per line.
"""

import fnmatch
import json
import os
import shutil
import sys
from pathlib import Path


def local_path(location: str) -> Path:
    if location.startswith("s3://"):
        return Path(os.environ["FAKE_S3_ROOT"]) / location.removeprefix("s3://")
    return Path(location)


def included(relative: str, filters: list[tuple[str, str]]) -> bool:
    result = True
    for kind, pattern in filters:
        if fnmatch.fnmatch(relative, pattern):
            result = kind == "--include"
    return result


def s3_cp(args: list[str]) -> int:
    recursive, filters, positional = False, [], []
    items = iter(args)
    for arg in items:
        if arg == "--recursive":
            recursive = True
        elif arg in ("--exclude", "--include"):
            filters.append((arg, next(items)))
        elif arg.startswith("--"):
            continue
        else:
            positional.append(arg)
    source_uri, target_uri = positional
    source, target = local_path(source_uri), local_path(target_uri)

    if not recursive:
        if not source.is_file():
            print(f"fatal error: {source_uri} does not exist", file=sys.stderr)
            return 1
        if target_uri.endswith("/"):
            target = target / source.name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, target)
        return 0

    if not source.is_dir():
        return 0  # an empty prefix is not an error for the real CLI either
    for path in sorted(source.rglob("*")):
        relative = path.relative_to(source).as_posix()
        if path.is_file() and included(relative, filters):
            destination = target / relative
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(path, destination)
    return 0


def main() -> int:
    args = sys.argv[1:]
    with Path(os.environ["FAKE_AWS_LOG"]).open("a") as log:
        log.write(json.dumps(args) + "\n")

    if args[:2] == ["s3", "cp"]:
        return s3_cp(args[2:])
    if args[:2] == ["stepfunctions", "start-execution"]:
        name = args[args.index("--name") + 1]
        print(f"arn:aws:states:eu-central-1:111111111111:execution:jmeter-load-test:{name}")
        return 0
    if args[:2] == ["stepfunctions", "describe-execution"]:
        if "[error, cause]" in args:
            print(os.environ.get("FAKE_SFN_ERROR", "None\tNone"))
        else:
            print(os.environ.get("FAKE_SFN_STATUS", "SUCCEEDED"))
        return 0
    print(f"fake aws: unsupported command {args}", file=sys.stderr)
    return 255


if __name__ == "__main__":
    sys.exit(main())
